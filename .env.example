# Copy to .env.local for development. Never commit real values.
# Public values are shipped to the browser; everything else stays on the server.

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server only. Bypasses Row Level Security. Used by the seed import, the proxy, the job
# runner, the webhook, the daily keep-alive and a few routes, each only after its own access
# decision; never handed to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# The site's own origin, used to build share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Vercel Cron sends this as a bearer token to the daily keep-alive.
CRON_SECRET=generate-a-long-random-string
# The same secret authorises POST /api/jobs/kick: the chain from one function to the
# next while jobs are due, and any external pinger (docs/going-live.md).

# The meeting bot (optional; without these the bot shows as not configured).
# Attendee API key, and the project's webhook secret (Settings -> Webhooks in Attendee).
# Only for a self-hosted Attendee; the hosted service's address is the default.
# ATTENDEE_API_URL=https://app.attendee.dev
ATTENDEE_API_KEY=
ATTENDEE_WEBHOOK_SECRET=
# Where the transcript comes from: "captions" (the platform's live captions; free, but they
# drop words) or "deepgram" (streamed through Attendee, far more accurate; needs a Deepgram
# key saved in the Attendee project, docs/going-live.md).
# ATTENDEE_TRANSCRIPTION=captions
# Deepgram's language: "multi" (default) catches Urdu or Hindi spoken in an English call;
# "en" is English only with "AFK" boosted as a key term.
# ATTENDEE_DEEPGRAM_LANGUAGE=multi
# There is no variable for the deployment-wide bot cap: it is the bot_daily_cap row in the
# app_settings table (20 bot requests in 24 hours across all users; each user and each place
# also has 5 a day).

# Connectors (Gmail, Google Calendar, Slack; optional). Without these the Connectors page
# says the app is not set up. The first one seals every token.
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTOR_TOKEN_KEY=
# The Google OAuth client (the one sign-in uses), with the redirect URI
# <site>/connectors/google/callback added and the gmail.send, calendar.events,
# contacts.readonly and contacts.other.readonly scopes (docs/going-live.md section 4b).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A Slack app (api.slack.com/apps) with the redirect URL <site>/connectors/slack/callback
# and the bot scopes chat:write, chat:write.public, channels:read.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# The Claude API key that writes the notes, the command parse, the learned lines and the
# live answers (Claude Console -> API keys). Without it, AI jobs wait and the page says so.
# The same key goes into Vercel for the deployed site.
ANTHROPIC_API_KEY=
# The model every call uses (default claude-sonnet-5-5; claude-haiku-4-5 is the cheaper one).
# CLAUDE_MODEL=claude-sonnet-5-5

# Optional, and usually not set by hand. Vercel sets the first two on every deployment.
# The production host (no scheme): the bot's webhook and the job chain post to https://<it>;
# without it they use NEXT_PUBLIC_SITE_URL.
# VERCEL_PROJECT_PRODUCTION_URL=your-app.vercel.app
# Vercel sets this; it only names the job runner's worker id (web-<region>-...).
# VERCEL_REGION=bom1
# Only for `supabase config push` from your machine: supabase/config.toml reads the Google
# sign-in client from these (docs/going-live.md section 1). The app never reads them.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
