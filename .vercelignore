# What a `vercel deploy` from this folder must never upload. Git deploys only ever see
# tracked files; a CLI deploy reads the folder, so secrets and bulky local files are
# listed here too.
.env
.env.*
!.env.example
.agent-logs
.metrics
data
node_modules
.next
test-results
playwright-report
coverage
supabase/.temp
*.tsbuildinfo
